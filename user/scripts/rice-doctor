#!/usr/bin/env bash
set -euo pipefail
fail=0
ok()   { printf 'OK   %s\n' "$1"; }
bad()  { printf 'FAIL %s\n' "$1"; fail=1; }
warn() { printf 'WARN %s\n' "$1"; }
need() { command -v "$1" >/dev/null 2>&1 && ok "command: $1" || bad "command: $1"; }

printf 'v12 RC7 T440 workstation checks\n\n'

for c in \
  sway swaymsg foot footclient qutebrowser dunst dunstctl waybar fuzzel \
  magick jq wpctl pw-metadata reaper brightnessctl grim slurp swayidle swaylock \
  wl-copy wl-paste cliphist notify-send nvim yazi htop rice-fetch nmtui \
  blueman-manager flatpak lxqt-policykit-agent rice-plumb rice-windows \
  rice-window-placement rice-clipboard file udisksctl vainfo
 do
  need "$c"
done

for f in \
  "$HOME/.config/sway/config" \
  "$HOME/.config/foot/foot.ini" \
  "$HOME/.config/rice/reference/reference.png" \
  "$HOME/.local/share/rice/wallpaper.jpg" \
  "$HOME/.config/rice/audio.env" \
  "$HOME/.config/rice/generated/palette.json" \
  "$HOME/.config/rice/generated/sway-colors.conf" \
  "$HOME/.config/rice/generated/qute-colors.py" \
  "$HOME/.config/rice/generated/web.css" \
  "$HOME/.config/rice/generated/dunstrc" \
  "$HOME/.config/rice/yazi/theme.toml" \
  "$HOME/.config/rice/waybar/config.json" \
  "$HOME/.config/rice/waybar/style.css" \
  "$HOME/.config/rice/qt-square.qss"
do
  [ -s "$f" ] && ok "file: $f" || bad "file: $f"
done

printf '\nSyntax/theme\n'
if fc-match -f '%{family}\n' 'PxPlus IBM VGA 8x16' | head -1 | grep -Fq 'PxPlus IBM VGA 8x16'; then ok 'font: PxPlus IBM VGA 8x16'; else bad 'font: PxPlus IBM VGA 8x16'; fi
if foot -C -c "$HOME/.config/foot/foot.ini" >/dev/null 2>&1; then ok 'Foot config'; else bad 'Foot config'; fi
if sway -C -c "$HOME/.config/sway/config" >/dev/null 2>&1; then ok 'Sway config'; else bad 'Sway config'; fi
if python3 - <<'PY' >/dev/null 2>&1
from pathlib import Path
compile(Path.home().joinpath('.config/qutebrowser/config.py').read_text(), 'config.py', 'exec')
PY
then ok 'qutebrowser config syntax'; else bad 'qutebrowser config syntax'; fi
if python3 - <<'PY' >/dev/null 2>&1
import tomllib
from pathlib import Path
tomllib.loads(Path.home().joinpath('.config/rice/yazi/theme.toml').read_text())
PY
then ok 'Yazi theme TOML'; else bad 'Yazi theme TOML'; fi
if jq -e . "$HOME/.config/rice/waybar/config.json" >/dev/null 2>&1; then ok 'Waybar JSON'; else bad 'Waybar JSON'; fi

if jq -e '
  length == 2 and
  .[0]["modules-left"] == ["clock"] and
  (.[0]["modules-right"] // []) == [] and
  .[1]["modules-right"] == ["custom/rice-status"] and
  (.[1]["modules-left"] // []) == []
' "$HOME/.config/rice/waybar/config.json" >/dev/null 2>&1; then
  ok 'original sparse bars: clock only + rice-status only'
else
  bad 'Waybar gained extra modules/clutter'
fi

if fuzzel --check-config --config="$HOME/.config/rice/generated/fuzzel.ini" >/dev/null 2>&1; then ok 'Fuzzel config'; else bad 'Fuzzel config'; fi
if awk '
  /^\[border\]$/ { in_border=1; next }
  /^\[/ { in_border=0 }
  in_border && /^radius=0$/ { radius=1 }
  in_border && /^selection-radius=0$/ { selection=1 }
  END { exit !(radius && selection) }
' "$HOME/.config/rice/generated/fuzzel.ini"; then ok 'Fuzzel square corners'; else bad 'Fuzzel square corners'; fi
grep -Eq '^[[:space:]]*corner_radius[[:space:]]*=[[:space:]]*0$' "$HOME/.config/rice/generated/dunstrc" && ok 'Dunst square corners' || bad 'Dunst square corners'
grep -Fq 'border-radius: 0' "$HOME/.config/rice/waybar/style.css" && ok 'Waybar square corners' || bad 'Waybar square corners'
grep -Fq 'border-radius: 0' "$HOME/.config/gtk-3.0/gtk.css" && ok 'GTK3 square CSS' || bad 'GTK3 square CSS'
grep -Fq 'border-radius: 0' "$HOME/.config/gtk-4.0/gtk.css" && ok 'GTK4 square CSS' || bad 'GTK4 square CSS'

if grep -Eiq 'filter[[:space:]]*:|grayscale\(|invert\(' "$HOME/.config/rice/generated/web.css"; then
  bad 'web CSS contains media recoloring/filtering'
else
  ok 'web content has no grayscale/invert filter'
fi
if grep -Eq 'colors\.webpage\.darkmode\.enabled.*(False|false)' "$HOME/.config/qutebrowser/config.py" 2>/dev/null; then
  ok 'qutebrowser forced webpage dark filter disabled'
else
  warn 'could not confirm qutebrowser darkmode.enabled=False in generated config'
fi

printf '\nWindow policy/session\n'
grep -Fq 'dwt disabled' "$HOME/.config/sway/config" && ok 'touchpad DWT disabled' || bad 'touchpad DWT not disabled'
if grep -E 'for_window.*(resize set|move position [0-9])' "$HOME/.config/sway/config" >/dev/null; then
  bad 'hard-coded staged window coordinates remain in Sway config'
else
  ok 'Sway config has no staged app coordinates'
fi
if ! grep -Fq 'RANDOM' "$HOME/.local/bin/rice-window-placement" \
   && grep -Fq "printf '2\\n'" "$HOME/.local/bin/rice-window-placement" \
   && grep -Fq "printf '3\\n'" "$HOME/.local/bin/rice-window-placement" \
   && grep -Fq "printf '4\\n'" "$HOME/.local/bin/rice-window-placement" \
   && grep -Fq 'fullscreen enable' "$HOME/.local/bin/rice-window-placement"; then
  ok 'art-directed workspace placement + fullscreen policy present'
else
  bad 'window placement policy missing'
fi

[ "${XDG_CURRENT_DESKTOP:-}" = "sway" ] && ok 'XDG_CURRENT_DESKTOP=sway' || warn "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}"
[ "${XDG_SESSION_TYPE:-}" = "wayland" ] && ok 'XDG_SESSION_TYPE=wayland' || warn "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset}"
[ "${XDG_SESSION_DESKTOP:-}" = "sway" ] && ok 'XDG_SESSION_DESKTOP=sway' || warn "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-unset}"
for unit in sway-session.target xdg-desktop-portal.service xdg-desktop-portal-wlr.service; do
  if systemctl --user cat "$unit" >/dev/null 2>&1; then ok "user unit present: $unit"; else warn "user unit missing/not visible: $unit"; fi
done
for unit in rice-polkit-agent.service rice-window-placement.service rice-cliphist-text.service; do
  if systemctl --user is-active --quiet "$unit" 2>/dev/null; then ok "active: $unit"; else warn "not active: $unit"; fi
done

printf '\nAudio\n'
if wpctl status >/dev/null 2>&1; then ok 'PipeWire/WirePlumber responding'; else bad 'PipeWire/WirePlumber not responding'; fi
# shellcheck disable=SC1090
. "$HOME/.config/rice/audio.env"
if [[ "${RICE_AUDIO_RATE:-}" =~ ^[0-9]+$ ]]    && [[ "${RICE_STUDIO_QUANTUM:-}" =~ ^[0-9]+$ ]]    && [[ "${RICE_SAFE_QUANTUM:-}" =~ ^[0-9]+$ ]]; then
  ok "audio profile: ${RICE_AUDIO_RATE} Hz / ${RICE_STUDIO_QUANTUM} studio / ${RICE_SAFE_QUANTUM} safe"
else
  bad "invalid audio profile values: rate=${RICE_AUDIO_RATE:-?} studio=${RICE_STUDIO_QUANTUM:-?} safe=${RICE_SAFE_QUANTUM:-?}"
fi
rt="$(ulimit -r 2>/dev/null || echo 0)"
if [[ "$rt" =~ ^[0-9]+$ ]] && [ "$rt" -ge 90 ]; then ok "realtime priority limit: $rt"; else warn "realtime priority limit: $rt (expected about 95 after login)"; fi
ml="$(ulimit -l 2>/dev/null || true)"
[ "$ml" = "unlimited" ] && ok 'memlock: unlimited' || warn "memlock: ${ml:-unknown}"
printf 'INFO PipeWire quantum metadata:\n'
pw-metadata -n settings 2>/dev/null | grep -E 'clock\.(force-quantum|quantum|min-quantum|max-quantum)' || true

printf '\nHardware/system\n'
if compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then ok 'battery sysfs'; else warn 'battery sysfs: no BAT* found'; fi
if vainfo >/dev/null 2>&1; then ok 'Intel VA-API'; else warn 'VA-API test failed (may be harmless outside a graphical session)'; fi
if systemctl is-enabled --quiet udisks2.service 2>/dev/null || systemctl cat udisks2.service >/dev/null 2>&1; then ok 'udisks2 available'; else warn 'udisks2 service not visible'; fi
if systemctl is-enabled --quiet speech-dispatcher.service 2>/dev/null; then warn 'speechd appears enabled (minimal profile expected it off)'; else ok 'speechd not enabled'; fi
if systemctl is-enabled --quiet systemd-oomd.service 2>/dev/null; then warn 'systemd-oomd enabled (RC7 expects it disabled)'; else ok 'systemd-oomd disabled'; fi
if command -v tlp-stat >/dev/null 2>&1; then
  printf 'TLP processor summary:\n'
  tlp-stat -p 2>/dev/null | grep -E 'scaling_driver|scaling_governor|energy_performance' | head -12 || true
fi
if command -v swapon >/dev/null 2>&1; then printf 'Swap inventory:\n'; swapon --show || true; fi

printf '\nFlatpak\n'
if flatpak remote-list --user --columns=name 2>/dev/null | grep -Fxq flathub; then ok 'Flathub user remote'; else warn 'Flathub not ready yet; run flatpak-bootstrap'; fi
if flatpak info --user org.libretro.RetroArch >/dev/null 2>&1; then
  ok 'Flatpak app: org.libretro.RetroArch'
else
  warn 'RetroArch Flatpak missing (flatpak-bootstrap installs it)'
fi
retro_override="$(flatpak override --user --show org.libretro.RetroArch 2>/dev/null || true)"
if grep -Fq '!host' <<<"$retro_override" && grep -Eq 'Games(:create)?([;]|$)' <<<"$retro_override"; then
  ok 'RetroArch host filesystem removed; Games directory retained'
else
  warn 'RetroArch filesystem overrides not fully confirmed; rerun flatpak-bootstrap'
fi

printf '\nFailed units (informational)\n'
failed_system="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
if [ -z "${failed_system//[[:space:]]/}" ]; then ok 'no failed system units'; else warn 'failed system units present'; printf '%s\n' "$failed_system"; fi
failed_user="$(systemctl --user --failed --no-legend --plain 2>/dev/null || true)"
if [ -z "${failed_user//[[:space:]]/}" ]; then ok 'no failed user units'; else warn 'failed user units present'; printf '%s\n' "$failed_user"; fi

exit "$fail"
