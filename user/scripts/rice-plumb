#!/usr/bin/env bash
set -euo pipefail

# Plan 9/9front-inspired plumbing without a resident daemon. If no explicit
# argument is given, prefer the Wayland primary selection (closest to rio's
# selected text), then fall back to the regular clipboard.
target="${1:-}"
if [ -z "$target" ]; then
  target="$(wl-paste --primary --no-newline 2>/dev/null || true)"
fi
if [ -z "$target" ]; then
  target="$(wl-paste --no-newline 2>/dev/null || true)"
fi

# A plumber message is intentionally one target, not arbitrary multiline data.
target="${target%%$'\n'*}"
target="${target//$'\r'/}"
[ -n "$target" ] || exit 0

case "$target" in
  http://*|https://*)
    exec qutebrowser "$target"
    ;;
esac

if [[ "$target" == "~/"* ]]; then
  target="$HOME/${target:2}"
fi

# Compiler/editor-style path:line[:column], one of rio/plumber's classic uses.
# Match the 3-part form first so a greedy path capture cannot swallow :line.
path=""; line=""; col="1"
if [[ "$target" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
  path="${BASH_REMATCH[1]}"
  line="${BASH_REMATCH[2]}"
  col="${BASH_REMATCH[3]}"
elif [[ "$target" =~ ^(.+):([0-9]+)$ ]]; then
  path="${BASH_REMATCH[1]}"
  line="${BASH_REMATCH[2]}"
fi
if [ -n "$path" ] && [ -f "$path" ]; then
  exec rice-foot -a editor -T nvim nvim "+call cursor($line, $col)" "$path"
fi

if [ -d "$target" ]; then
  exec rice-foot -a yazi -T yazi rice-yazi "$target"
fi

if [ -f "$target" ]; then
  mime="$(file --brief --mime-type -- "$target" 2>/dev/null || true)"
  case "$mime" in
    application/pdf)
      exec zathura "$target"
      ;;
    image/*)
      exec imv "$target"
      ;;
    audio/*|video/*)
      exec mpv "$target"
      ;;
    text/*|application/json|application/xml|application/x-shellscript)
      exec rice-foot -a editor -T nvim nvim "$target"
      ;;
  esac
fi

notify-send "plumb" "No safe rule for the current selection."
