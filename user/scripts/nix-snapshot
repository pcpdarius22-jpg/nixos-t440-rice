#!/usr/bin/env bash
set -euo pipefail
DIR="${NIXOS_CONFIG_DIR:-$HOME/nixos-config}"
[ -f "$DIR/flake.nix" ] || { echo "No flake at $DIR" >&2; exit 1; }
cd "$DIR"
if [ ! -d .git ]; then
  git init -q
  git config user.name 'sloth'
  git config user.email 'sloth@thinkpad.local'
fi
git add -A
if git diff --cached --quiet; then
  echo 'No config changes to snapshot.'
  exit 0
fi
msg="${*:-checkpoint $(date '+%Y-%m-%d %H:%M:%S')}"
git commit -m "$msg"
